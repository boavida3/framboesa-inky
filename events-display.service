[Unit]
Description=E-ink Calendar Display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/events-display
ExecStart=/usr/bin/python3 /home/pi/events-display/events_display.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
