# Private iCal (.ics) calendar URLs
# Get them from your calendar app's settings
# → "Secret address in iCal format"
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env

DISPLAY_TZ=America/Los_Angeles

# One URL per calendar; calendars 1, 2 and 3 each get their own bar color
GCAL_ICAL_URL_1=https://example.com/private-XXXX/calendar.ics
GCAL_ICAL_URL_2=https://example.com/private-XXXX/calendar.ics
