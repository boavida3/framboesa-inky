# Google Calendar private iCal URLs
# Get them from: Google Calendar → Settings → [Calendar] → Integrate calendar
# → "Secret address in iCal format"
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env

DISPLAY_TZ=America/Los_Angeles

# One URL per calendar (up to 3 get their own sidebar color) and an optional label shown on the display
GCAL_ICAL_URL_1=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID_1/private-XXXX/basic.ics
GCAL_NAME_1=Me
GCAL_ICAL_URL_2=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID_2/private-XXXX/basic.ics
GCAL_NAME_2=Partner
